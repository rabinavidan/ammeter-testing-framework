# Generated by every run (logs, archive, plots, accuracy reports). Anchored with a leading "/": a bare
# "results/" would also match the source package src/results/ and leave it out of git.
# A curated sample set is kept in sample_results/.
/results/

# Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.hypothesis/
.tox/
.nox/

# Python packaging output
/build/
/dist/
*.egg-info/
.eggs/

# Allure: raw results and generated report
/allure-results/
/allure-report/

# Throwaway image-pinning layers written by tools/deploy.sh
/deploy/k8s/.deploy-*/

# Docker report output and coverage
/reports/
coverage.xml
.coverage
.coverage.*
htmlcov/
coverage.json
*.cover
*.py,cover
.mypy_cache/
.ruff_cache/
.pytype/

# IDE settings (personal)
.idea/
.vscode/
*.swp
*.swo
*~

# Machine-specific credentials.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Internal AI development tooling and working notes: kept locally, not published.
# Nothing in the framework, its tests or CI depends on them (check.py skips the knowledge-base check without kb.py).
CLAUDE.md
.claude/
STATUS.md
DEVELOPMENT_LOG.md
knowledge/
tools/kb.py
tests/unit/test_knowledge_base.py
evals/kb_questions.json
evals/kb_questions_heldout.json
docs/ai-tooling.md

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
